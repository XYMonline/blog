---
import { getCategoryCounts, getSortedPosts, getTagCounts, totalChars } from '../../lib/blog';

const posts = await getSortedPosts();
const categories = await getCategoryCounts();
const tags = await getTagCounts();

const rows: [string, string][] = [
	['文章', String(posts.length)],
	['分类', String(categories.length)],
	['标签', String(tags.length)],
	['字数', totalChars.toLocaleString()],
];
---

<section class="widget stats-widget" aria-label="站点统计">
	<h3 class="widget-title">站点统计</h3>
	<ul class="widget-body">
		{
			rows.map(([label, value]) => (
				<li>
					<span class="label">{label}</span>
					<span class="value">{value}</span>
				</li>
			))
		}
	</ul>
</section>

<style>
	ul {
		list-style: none;
		margin: 0;
		padding: 0.35rem;
	}
	li {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.4rem 0.6rem;
		border-radius: 8px;
		font-size: 0.92em;
		color: var(--text);
	}
	.label {
		color: var(--muted);
	}
	.value {
		font-weight: 600;
		color: var(--heading);
	}
</style>