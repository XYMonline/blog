---
import { getHubCounts, hubSlug } from '../../lib/blog';

const hubs = await getHubCounts();
---

<nav class="widget hubs-widget" aria-label="文章专题">
	<h3 class="widget-title">专题<span class="count">{hubs.length}</span></h3>
	<ul class="widget-body">
		{
			hubs.length ? (
				hubs.map(([name, count]) => (
					<li>
						<a href={`/hubs/${hubSlug(name)}/`}>
							<span class="label">{name}</span>
							<span class="num">{count}</span>
						</a>
					</li>
				))
			) : (
				<li class="empty">暂无专题</li>
			)
		}
	</ul>
</nav>

<style>
	ul {
		list-style: none;
		margin: 0;
		padding: 0.35rem;
		display: grid;
		gap: 2px;
	}
	li {
		margin: 0;
	}
	a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.4rem 0.6rem;
		border-radius: 8px;
		color: var(--text);
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}
	a:hover {
		background: rgb(var(--gray-light), 55%);
		color: var(--accent);
	}
	.label {
		font-size: 0.92em;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		min-width: 0;
	}
	.num {
		flex: none;
		padding: 0.05rem 0.5rem;
		border-radius: 999px;
		background: rgb(var(--gray-light), 70%);
		color: var(--muted);
		font-size: 0.78em;
		font-weight: 600;
	}
	.empty {
		padding: 0.75rem;
		color: var(--muted);
		font-size: 0.85em;
	}
</style>