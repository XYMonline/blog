---
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { Image } from 'astro:assets';
import iconImage from '../../assets/icon.png';
---

<section class="widget author-card">
	<div class="avatar">
		<Image src={iconImage} alt={`${SITE_TITLE} 头像`} width="200" height="200" />
	</div>
	<div class="meta">
		<h2 class="name">{SITE_TITLE}</h2>
		<p class="bio">{SITE_DESCRIPTION}</p>
	</div>
</section>

<style>
	.author-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.9rem;
		padding: 1.4rem 1rem;
	}
	.avatar {
		flex: none;
		width: 5rem;
		height: 5rem;
		border-radius: 50%;
		overflow: hidden;
		border: 2px solid rgb(var(--gray-light));
		background: var(--accent);
	}
	.avatar :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 50%;
	}
	.meta {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.name {
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.3;
		color: var(--heading);
	}
	.bio {
		margin: 0;
		font-size: 1rem;
		line-height: 1.65;
		color: var(--muted);
	}
</style>