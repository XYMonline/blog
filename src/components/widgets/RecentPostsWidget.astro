---
import FormattedDate from '../FormattedDate.astro';
import { getSortedPosts } from '../../lib/blog';

const posts = (await getSortedPosts()).slice(0, 6);
---

<nav class="widget recent-widget" aria-label="最近更新">
	<h3 class="widget-title">最近更新</h3>
	<ul class="widget-body">
		{
			posts.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>
						<span class="title">{post.data.title}</span>
						<span class="date">
							<FormattedDate date={post.data.pubDate} />
						</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	ul {
		list-style: none;
		margin: 0;
		padding: 0.35rem;
	}
	li {
		margin: 0;
	}
	a {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: 0.45rem 0.6rem;
		border-radius: 8px;
		text-decoration: none;
		color: var(--text);
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}
	a:hover {
		background: rgb(var(--gray-light), 55%);
		color: var(--accent);
	}
	.title {
		font-size: 0.92em;
		font-weight: 600;
		line-height: 1.35;
		overflow: hidden;
		text-overflow: ellipsis;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
	}
	.date {
		font-size: 0.78em;
		color: var(--muted);
	}
</style>