---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	activeHref?: string;
}

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const { activeHref = '' } = Astro.props;

const stripTrailingSlash = (path: string) => (path.endsWith('/') ? path.slice(0, -1) : path);

const isActive = (href: string) => stripTrailingSlash(href) === stripTrailingSlash(activeHref);
---

<aside class="widget post-list-widget" aria-label="文章列表">
	<h2 class="widget-title">文章列表<span class="count">{posts.length}</span></h2>
	<nav class="widget-body">
		<ul>
			{
				posts.map((post) => {
					const href = `/blog/${post.id}/`;
					return (
						<li class:list={[{ active: isActive(href) }]}>
							<a href={href} aria-current={isActive(href) ? 'page' : undefined}>
								<span class="title">{post.data.title}</span>
								<span class="date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</a>
						</li>
					);
				})
			}
		</ul>
	</nav>
</aside>

<style>
	.post-list-widget {
		width: 100%;
	}
	.widget-body {
		padding: 0;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0.35rem;
	}
	li {
		margin: 0;
		border-radius: 8px;
	}
	li a {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: 0.45rem 0.65rem;
		border-radius: 8px;
		text-decoration: none;
		color: rgb(var(--gray-dark));
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}
	li a:hover {
		background: rgb(var(--gray-light), 60%);
		color: rgb(var(--accent));
	}
	.title {
		font-size: 0.92em;
		font-weight: 600;
		line-height: 1.35;
		overflow: hidden;
		text-overflow: ellipsis;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
	}
	.date {
		font-size: 0.78em;
		color: rgb(var(--gray));
	}
	li.active a {
		background: rgb(var(--accent));
		color: white;
	}
	li.active a .date {
		color: rgb(255 255 255 / 85%);
	}
</style>
