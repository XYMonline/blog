---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TableOfContents from '../components/TableOfContents.astro';
import AuthorCard from '../components/widgets/AuthorCard.astro';
import CategoriesWidget from '../components/widgets/CategoriesWidget.astro';
import HubsWidget from '../components/widgets/HubsWidget.astro';
import RecentPostsWidget from '../components/widgets/RecentPostsWidget.astro';
import SiteStatsWidget from '../components/widgets/SiteStatsWidget.astro';
import TagsWidget from '../components/widgets/TagsWidget.astro';

interface Props {
	title: string;
	description: string;
	/** 右栏内容:文章页=toc,其余页面=统计+最近更新 */
	right?: 'toc' | 'recent';
}

const { title, description, right = 'recent' } = Astro.props;
const showToc = right === 'toc';
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.shell {
				width: min(100% - 1rem, 96rem);
				margin: 0 auto;
				padding: 1.5rem 0.5rem 3rem;
				display: grid;
				grid-template-columns: minmax(0, 1fr);
				gap: 1.25rem 1.5rem;
				align-items: start;
				flex: 1 0 auto;
			}
			.aside {
				display: none;
				min-width: 0;
				flex-direction: column;
				gap: 1rem;
			}
			.aside > :global(*) {
				width: 100%;
				min-width: 0;
			}
			.aside--right {
				position: sticky;
				top: 1.5rem;
				max-height: calc(100vh - 3rem);
				overflow-y: auto;
				overflow-x: hidden;
			}
			.shell-main {
				width: 100%;
				max-width: none;
				margin: 0;
				padding: 0;
				min-width: 0;
			}

			/* 中等宽度:左侧栏 + 主内容 */
			@media (min-width: 56.25rem) {
				/* 900px */
				.shell {
					grid-template-columns: 17rem minmax(0, 1fr);
				}
				.aside--left {
					display: flex;
				}
			}

			/* 大宽度:左侧栏 + 主内容 + 右侧栏 */
			@media (min-width: 75rem) {
				/* 1200px */
				.shell {
					grid-template-columns: 17rem minmax(0, 1fr) 17rem;
				}
				.aside--right {
					display: flex;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<div class="shell">
			<div class="aside aside--left">
				<AuthorCard />
				<CategoriesWidget />
				<HubsWidget />
				<TagsWidget />
			</div>
			<main id="article-body" class="shell-main">
				<slot />
			</main>
			<div class="aside aside--right">
				{showToc ? (
					<TableOfContents tocId="toc-nav" />
				) : (
					<>
						<SiteStatsWidget />
						<RecentPostsWidget />
					</>
				)}
			</div>
		</div>
		<Footer />
	</body>
</html>