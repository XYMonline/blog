---
import { Image } from 'astro:assets';
import MainLayout from '../../layouts/MainLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getHubCounts, getPostsOfHub, hubSlug } from '../../lib/blog';

export async function getStaticPaths() {
	const hubs = await getHubCounts();
	return hubs.map(([name]) => ({
		params: { slug: hubSlug(name) },
		props: { name },
	}));
}

const { name } = Astro.props;
const posts = await getPostsOfHub(name);
---

<MainLayout title={`${SITE_TITLE} · 专题 · ${name}`} description={SITE_DESCRIPTION}>
	<section class="hub-detail">
		<div class="head">
			<h2 class="section-title">{name}</h2>
			<span class="count">{posts.length} 篇文章</span>
		</div>

		<div class="grid">
			{
				posts.map((post) => (
					<a class="card" href={`/blog/${post.id}/`}>
						{
							post.data.heroImage && (
								<div class="cover">
									<Image width={720} height={360} src={post.data.heroImage} alt="" />
								</div>
							)
						}
						<div class="body">
							<div class="meta">
								<FormattedDate date={post.data.pubDate} />
								{post.data.category && <span class="cat">{post.data.category}</span>}
							</div>
							<h3 class="title">{post.data.title}</h3>
							<p class="desc">{post.data.description}</p>
						</div>
					</a>
				))
			}
		</div>
	</section>
</MainLayout>

<style>
	.hub-detail {
		max-width: 62rem;
		margin: 0 auto;
	}
	.head {
		display: flex;
		align-items: baseline;
		gap: 0.8rem;
		margin-bottom: 1.25rem;
	}
	.section-title {
		margin: 0;
		font-size: 1.5rem;
		color: var(--heading);
	}
	.count {
		font-size: 0.9em;
		color: var(--muted);
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.25rem;
	}
	.card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: var(--surface);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		text-decoration: none;
		color: var(--text);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}
	.card:hover {
		transform: translateY(-2px);
		box-shadow: var(--box-shadow);
	}
	.cover img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}
	.body {
		padding: 0.9rem 1rem 1.1rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		flex: 1;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.8em;
		color: var(--muted);
	}
	.cat {
		padding: 0.05rem 0.5rem;
		border-radius: 999px;
		background: rgb(var(--gray-light), 70%);
		color: var(--muted);
		font-weight: 600;
	}
	.title {
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.35;
		color: var(--heading);
	}
	.desc {
		margin: 0;
		font-size: 0.88em;
		line-height: 1.5;
		color: var(--muted);
		overflow: hidden;
		text-overflow: ellipsis;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
	}
</style>